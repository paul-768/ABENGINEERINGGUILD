// Simple brute force initialization
document.addEventListener('DOMContentLoaded', function() {
    console.log('🏠 DOM READY - INITIALIZING POST ACTIONS');
    initializePostActions();
});

function initializePostActions() {
    console.log('🎯 SETTING UP CLICK LISTENERS');
    
    // Handle three dots button clicks
    document.addEventListener('click', function(e) {
        // Three dots button
        if (e.target.closest('.post-options-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.post-options-btn');
            console.log('📋 THREE DOTS CLICKED:', button.dataset.postId);
            toggleDropdown(button);
        }
        
        // Edit post
        else if (e.target.closest('.edit-post-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.edit-post-btn');
            const postId = button.dataset.postId;
            console.log('✏️ EDIT POST:', postId);
            editPost(postId);
            closeAllDropdowns();
        }
        
        // Delete post
        else if (e.target.closest('.delete-post-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.delete-post-btn');
            const postId = button.dataset.postId;
            console.log('🗑️ DELETE POST:', postId);
            deletePost(postId);
            closeAllDropdowns();
        }
        
        // Hide post
        else if (e.target.closest('.hide-post-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.hide-post-btn');
            const postId = button.dataset.postId;
            console.log('👁️ HIDE POST:', postId);
            hidePost(postId);
            closeAllDropdowns();
        }
        
        // Save post
        else if (e.target.closest('.save-post-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.save-post-btn');
            const postId = button.dataset.postId;
            console.log('💾 SAVE POST:', postId);
            savePost(postId, button);
            closeAllDropdowns();
        }
        
        // Mark as interesting
        else if (e.target.closest('.interest-post-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.interest-post-btn');
            const postId = button.dataset.postId;
            console.log('⭐ INTEREST POST:', postId);
            markAsInteresting(postId, button);
            closeAllDropdowns();
        }
        
        // Snooze post
        else if (e.target.closest('.snooze-post-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.snooze-post-btn');
            const postId = button.dataset.postId;
            console.log('⏰ SNOOZE POST:', postId);
            snoozePost(postId);
            closeAllDropdowns();
        }
        
        // Share post from dropdown
        else if (e.target.closest('.share-post-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.share-post-btn');
            const postId = button.dataset.postId;
            console.log('🔗 SHARE POST:', postId);
            sharePost(postId);
            closeAllDropdowns();
        }
        
        // Share from stats button
        else if (e.target.closest('.share-post-stats-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const button = e.target.closest('.share-post-stats-btn');
            const postId = button.dataset.postId;
            console.log('📊 SHARE FROM STATS:', postId);
            sharePost(postId);
        }
        
        // Close dropdowns when clicking outside
        else if (!e.target.closest('.post-options-btn') && !e.target.closest('.post-dropdown-menu')) {
            closeAllDropdowns();
        }
    });
}

function toggleDropdown(button) {
    console.log('📋 TOGGLING DROPDOWN');
    
    // Close all dropdowns first
    closeAllDropdowns();
    
    // Find and toggle the dropdown
    const dropdown = button.nextElementSibling;
    if (dropdown && dropdown.classList.contains('post-dropdown-menu')) {
        dropdown.classList.toggle('hidden');
        console.log('✅ DROPDOWN TOGGLED');
    }
}

function closeAllDropdowns() {
    document.querySelectorAll('.post-dropdown-menu').forEach(menu => {
        menu.classList.add('hidden');
    });
}

// ========== POST ACTION FUNCTIONS ==========

async function editPost(postId) {
    try {
        console.log('📝 FETCHING POST DATA:', postId);
        const response = await fetch(`/community/api/get_post/${postId}`);
        const data = await response.json();
        
        if (data.success) {
            const post = data.data;
            const newContent = prompt('Edit your post:', post.content);
            const newTitle = post.title ? prompt('Edit title:', post.title) : '';
            
            if (newContent !== null) {
                console.log('💾 SENDING EDIT REQUEST');
                const editResponse = await fetch(`/community/api/edit_post/${postId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': getCSRFToken()
                    },
                    body: JSON.stringify({
                        content: newContent,
                        title: newTitle
                    })
                });
                
                const editData = await editResponse.json();
                if (editData.success) {
                    alert('✅ Post updated successfully!');
                    location.reload();
                } else {
                    alert('❌ Error: ' + editData.message);
                }
            }
        } else {
            alert('❌ Error loading post: ' + data.message);
        }
    } catch (error) {
        console.error('Edit post error:', error);
        alert('❌ Error editing post');
    }
}

async function deletePost(postId) {
    console.log('🔄 DELETE POST STARTED:', postId);
    
    if (confirm('Are you sure you want to delete this post?')) {
        try {
            console.log('📤 SENDING DELETE REQUEST...');
            
            const response = await fetch(`/community/api/delete_post/${postId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                    // Remove CSRF token temporarily for testing
                }
            });
            
            console.log('✅ RESPONSE STATUS:', response.status);
            console.log('✅ RESPONSE OK:', response.ok);
            
            const data = await response.json();
            console.log('📥 RESPONSE DATA:', data);
            
            if (data.success) {
                alert('SUCCESS: ' + data.message);
                // Remove post from view
                const postElement = document.querySelector(`[data-post-id="${postId}"]`)?.closest('.bg-white');
                if (postElement) postElement.remove();
            } else {
                alert('ERROR: ' + data.message);
            }
            
        } catch (error) {
            console.error('❌ CATCH ERROR:', error);
            alert('NETWORK ERROR: ' + error.message);
        }
    }
}

async function hidePost(postId) {
    try {
        console.log('👁️ HIDING POST:', postId);
        const response = await fetch(`/community/api/hide_post/${postId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCSRFToken()
            }
        });
        
        const data = await response.json();
        console.log('Hide response:', data);
        
        if (data.success) {
            alert('✅ ' + data.message);
            // Hide the post element
            const postElement = document.querySelector(`[data-post-id="${postId}"]`)?.closest('.bg-white');
            if (postElement) {
                postElement.style.display = 'none';
            }
        } else {
            alert('❌ ' + data.message);
        }
    } catch (error) {
        console.error('Hide post error:', error);
        alert('❌ Error hiding post');
    }
}

async function savePost(postId, button) {
    try {
        console.log('💾 SAVING POST:', postId);
        const response = await fetch(`/community/api/save_post/${postId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCSRFToken()
            }
        });
        
        const data = await response.json();
        console.log('Save response:', data);
        
        if (data.success) {
            const saveText = button.querySelector('.save-text');
            if (data.saved) {
                saveText.textContent = 'Unsave';
                button.classList.add('text-blue-600');
                alert('✅ ' + data.message);
            } else {
                saveText.textContent = 'Save';
                button.classList.remove('text-blue-600');
                alert('ℹ️ ' + data.message);
            }
        } else {
            alert('❌ ' + data.message);
        }
    } catch (error) {
        console.error('Save post error:', error);
        alert('❌ Error saving post');
    }
}

async function markAsInteresting(postId, button) {
    try {
        console.log('⭐ MARKING INTEREST:', postId);
        const response = await fetch(`/community/api/mark_interest/${postId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCSRFToken()
            },
            body: JSON.stringify({
                interest_type: 'interested'
            })
        });
        
        const data = await response.json();
        console.log('Interest response:', data);
        
        if (data.success) {
            const interestText = button.querySelector('.interest-text');
            if (data.interested) {
                interestText.textContent = 'Mark as Not Interesting';
                button.classList.add('text-yellow-600');
                alert('✅ ' + data.message);
            } else {
                interestText.textContent = 'Mark as Interesting';
                button.classList.remove('text-yellow-600');
                alert('ℹ️ ' + data.message);
            }
        } else {
            alert('❌ ' + data.message);
        }
    } catch (error) {
        console.error('Mark interest error:', error);
        alert('❌ Error marking interest');
    }
}

async function snoozePost(postId) {
    const duration = prompt('Snooze post for how many hours? (Enter a number):', '24');
    if (duration && !isNaN(duration)) {
        try {
            console.log('⏰ SNOOZING POST:', postId, 'for', duration, 'hours');
            const response = await fetch(`/community/api/snooze_post/${postId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': getCSRFToken()
                },
                body: JSON.stringify({
                    hours: parseInt(duration)
                })
            });
            
            const data = await response.json();
            console.log('Snooze response:', data);
            
            if (data.success) {
                alert(`✅ ${data.message}`);
                // Hide the post element
                const postElement = document.querySelector(`[data-post-id="${postId}"]`)?.closest('.bg-white');
                if (postElement) {
                    postElement.style.display = 'none';
                }
            } else {
                alert('❌ ' + data.message);
            }
        } catch (error) {
            console.error('Snooze post error:', error);
            alert('❌ Error snoozing post');
        }
    }
}

async function sharePost(postId) {
    try {
        console.log('🔗 SHARING POST:', postId);
        const response = await fetch(`/community/api/share_post/${postId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCSRFToken()
            }
        });
        
        const data = await response.json();
        console.log('Share response:', data);
        
        if (data.success) {
            // Copy to clipboard
            try {
                await navigator.clipboard.writeText(data.url);
                alert('✅ ' + data.message + ' - Link copied to clipboard!');
            } catch (clipboardError) {
                // Fallback for older browsers
                const textArea = document.createElement('textarea');
                textArea.value = data.url;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                alert('✅ ' + data.message + ' - Link copied to clipboard!');
            }
        } else {
            alert('❌ ' + data.message);
        }
    } catch (error) {
        console.error('Share post error:', error);
        alert('❌ Error sharing post');
    }
}

// Helper function to get CSRF token
function getCSRFToken() {
    // Try meta tag first
    const metaTag = document.querySelector('meta[name="csrf-token"]');
    if (metaTag) {
        return metaTag.getAttribute('content');
    }
    
    // Try form input
    const csrfInput = document.querySelector('input[name="csrf_token"]');
    if (csrfInput) {
        return csrfInput.value;
    }
    
    console.warn('⚠️ CSRF token not found');
    return '';
}

// Global functions for debugging
window.debugPostActions = {
    init: initializePostActions,
    closeAll: closeAllDropdowns,
    testEdit: (id) => editPost(id || 1),
    testDelete: (id) => deletePost(id || 1),
    testHide: (id) => hidePost(id || 1),
    testSave: (id) => {
        const btn = document.querySelector('.save-post-btn');
        savePost(id || 1, btn);
    }
};

