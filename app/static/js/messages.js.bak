// app/static/js/messages.js - NO TOAST VERSION
// This file is included via base.html

// Global variables
let socket = null;
let currentConversationId = null;
let messagePollInterval = null;
let typingTimeout = null;
let isTyping = false;

// Initialize Socket.IO connection
function initMessagesSocket() {
    if (typeof io !== 'undefined') {
        socket = io({
            transports: ['websocket', 'polling']
        });
        
        socket.on('connect', function() {
            console.log('Messages socket connected');
            
            // Join current conversation if on conversation page
            if (currentConversationId) {
                socket.emit('join_conversation', { conversation_id: currentConversationId });
            }
        });
        
        socket.on('new_message', function(data) {
            if (data.conversation_id === currentConversationId) {
                handleNewMessage(data.message_data);
            } else {
                // Update conversation list badge
                updateConversationListBadge(data.conversation_id);
            }
        });
        
        socket.on('message_read', function(data) {
            if (data.conversation_id === currentConversationId) {
                // Update read status in UI
                updateReadStatus(data.message_ids);
            }
        });
        
        socket.on('typing', function(data) {
            if (data.conversation_id === currentConversationId && data.user_id !== currentUserId) {
                showTypingIndicator(data.user_name);
            }
        });
        
        socket.on('message_unsent', function(data) {
            if (data.conversation_id === currentConversationId) {
                removeMessage(data.message_id);
            }
        });
        
        socket.on('message_edited', function(data) {
            if (data.conversation_id === currentConversationId) {
                updateMessageContent(data.message_id, data.new_content);
            }
        });
    }
}

// Send typing indicator
function sendTypingIndicator(conversationId) {
    if (socket && socket.connected) {
        socket.emit('typing', {
            conversation_id: conversationId,
            user_id: currentUserId,
            user_name: currentUserName
        });
    }
}

// Show typing indicator
function showTypingIndicator(userName) {
    const typingDiv = document.getElementById('typing-indicator');
    if (typingDiv) {
        typingDiv.innerHTML = `
            <div class="typing-indicator">
                ${userName} is typing
                <div class="typing-dots">
                    <span></span><span></span><span></span>
                </div>
            </div>
        `;
        typingDiv.classList.remove('hidden');
        
        clearTimeout(typingTimeout);
        typingTimeout = setTimeout(() => {
            typingDiv.classList.add('hidden');
        }, 3000);
    }
}

// Handle new message
function handleNewMessage(message) {
    // Check if message already exists
    const existing = document.querySelector(`.message-item[data-message-id="${message.id}"]`);
    if (!existing) {
        appendMessage(message);
        scrollToBottom();
        
        // Update last message ID
        if (message.id > lastMessageId) {
            lastMessageId = message.id;
        }
    }
}

// Append message to container
function appendMessage(msg) {
    const container = document.getElementById('messages-container');
    if (!container) return;
    
    const isOwn = msg.sender_id === currentUserId;
    
    let contentHtml = '';
    if (msg.message_type === 'image') {
        contentHtml = `<img src="/static/uploads/messages/${msg.file_path}" class="max-w-xs rounded-lg cursor-pointer" onclick="openImageViewer(this.src)">`;
    } else if (msg.message_type === 'file') {
        contentHtml = `
            <a href="/static/uploads/messages/${msg.file_path}" class="flex items-center space-x-2 text-sm" download>
                <i class="fas fa-file-alt text-lg"></i>
                <span>${escapeHtml(msg.file_name)}</span>
                <span class="text-xs opacity-70">(${Math.round(msg.file_size / 1024)} KB)</span>
            </a>
        `;
    } else {
        contentHtml = `<p class="text-sm whitespace-pre-wrap break-words">${escapeHtml(msg.content)}</p>`;
    }
    
    const messageDiv = document.createElement('div');
    messageDiv.className = `flex ${isOwn ? 'justify-end' : ''} message-item`;
    messageDiv.setAttribute('data-message-id', msg.id);
    messageDiv.innerHTML = `
        <div class="flex items-end space-x-2 max-w-[70%] ${isOwn ? 'flex-row-reverse space-x-reverse' : ''}">
            ${!isOwn ? `
            <div class="w-8 h-8 rounded-full bg-gradient-to-r from-green-600 to-green-700 flex items-center justify-center text-white text-xs flex-shrink-0 shadow-sm">
                ${msg.sender_name.charAt(0).toUpperCase()}
            </div>
            ` : ''}
            <div>
                <div class="message-bubble ${isOwn ? 'sent' : 'received'}">
                    ${contentHtml}
                    ${msg.is_edited ? '<span class="text-xs opacity-70 block mt-1">(edited)</span>' : ''}
                </div>
                <p class="text-xs text-gray-400 mt-1 ${isOwn ? 'text-right' : ''}">${msg.formatted_time || 'Just now'}</p>
            </div>
        </div>
    `;
    container.appendChild(messageDiv);
}

// Update conversation list badge
function updateConversationListBadge(conversationId) {
    const convItem = document.querySelector(`.conversation-item[data-conversation-id="${conversationId}"]`);
    if (convItem) {
        const badge = convItem.querySelector('.unread-badge');
        if (badge) {
            let count = parseInt(badge.textContent) || 0;
            count++;
            badge.textContent = count;
            badge.classList.remove('hidden');
        } else {
            const badgeSpan = document.createElement('span');
            badgeSpan.className = 'unread-badge bg-green-500 text-white text-xs px-1.5 py-0.5 rounded-full min-w-[20px] text-center';
            badgeSpan.textContent = '1';
            convItem.querySelector('.flex-1 .flex.items-center.justify-between').appendChild(badgeSpan);
        }
    }
}

// Scroll to bottom of messages
function scrollToBottom() {
    const container = document.getElementById('messages-container');
    if (container) {
        container.scrollTop = container.scrollHeight;
    }
}

// Auto-resize textarea
function autoResizeTextarea(textarea) {
    if (textarea) {
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 100) + 'px';
    }
}

// Send message via AJAX
async function sendMessage(conversationId, content) {
    if (!content.trim()) return false;
    
    try {
        const formData = new FormData();
        formData.append('content', content);
        
        const response = await fetch(`/messages/send_message/${conversationId}`, {
            method: 'POST',
            headers: {
                'X-CSRFToken': document.querySelector('meta[name="csrf-token"]').content
            },
            body: formData
        });
        
        const data = await response.json();
        if (data.success) {
            return data.message_data;
        } else {
            console.warn('Error sending message:', data.message);
            return false;
        }
    } catch (error) {
        console.error('Error sending message:', error);
        return false;
    }
}

// Upload file
async function uploadFile(conversationId, file) {
    try {
        const formData = new FormData();
        formData.append('file', file);
        
        const response = await fetch(`/messages/upload_file/${conversationId}`, {
            method: 'POST',
            headers: {
                'X-CSRFToken': document.querySelector('meta[name="csrf-token"]').content
            },
            body: formData
        });
        
        const data = await response.json();
        if (data.success) {
            return data.message_data;
        } else {
            console.warn('Error uploading file:', data.message);
            return false;
        }
    } catch (error) {
        console.error('Error uploading file:', error);
        return false;
    }
}

// Mark messages as read
async function markMessagesAsRead(conversationId) {
    try {
        const response = await fetch(`/messages/mark_read/${conversationId}`, {
            method: 'POST',
            headers: {
                'X-CSRFToken': document.querySelector('meta[name="csrf-token"]').content
            },
            headers: {
                'Content-Type': 'application/json'
            }
        });
        return await response.json();
    } catch (error) {
        console.error('Error marking messages as read:', error);
        return false;
    }
}

// Delete/unsend message
async function unsendMessage(messageId) {
    try {
        const response = await fetch(`/messages/unsend_message/${messageId}`, {
            method: 'POST',
            headers: {
                'X-CSRFToken': document.querySelector('meta[name="csrf-token"]').content
            },
            headers: {
                'Content-Type': 'application/json'
            }
        });
        const data = await response.json();
        if (data.success) {
            removeMessage(messageId);
        }
        return data;
    } catch (error) {
        console.error('Error unsending message:', error);
        return false;
    }
}

// Edit message
async function editMessage(messageId, newContent) {
    try {
        const response = await fetch(`/messages/edit_message/${messageId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ content: newContent })
        });
        const data = await response.json();
        if (data.success) {
            updateMessageContent(messageId, newContent);
        }
        return data;
    } catch (error) {
        console.error('Error editing message:', error);
        return false;
    }
}

// Remove message from UI
function removeMessage(messageId) {
    const messageEl = document.querySelector(`.message-item[data-message-id="${messageId}"]`);
    if (messageEl) {
        messageEl.remove();
    }
}

// Update message content in UI
function updateMessageContent(messageId, newContent) {
    const messageEl = document.querySelector(`.message-item[data-message-id="${messageId}"]`);
    if (messageEl) {
        const contentEl = messageEl.querySelector('.message-bubble p');
        if (contentEl) {
            contentEl.textContent = newContent;
        }
        // Add edited indicator if not present
        if (!messageEl.querySelector('.message-bubble .edited-indicator')) {
            const editedSpan = document.createElement('span');
            editedSpan.className = 'text-xs opacity-70 block mt-1 edited-indicator';
            editedSpan.textContent = '(edited)';
            messageEl.querySelector('.message-bubble').appendChild(editedSpan);
        }
    }
}

// NO TOAST FUNCTION - Removed completely

// Escape HTML
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Image viewer
function openImageViewer(src) {
    const viewer = document.getElementById('imageViewer');
    const viewerImg = document.getElementById('viewerImage');
    if (viewer && viewerImg) {
        viewerImg.src = src;
        viewer.classList.remove('hidden');
    }
}

function closeImageViewer() {
    const viewer = document.getElementById('imageViewer');
    if (viewer) {
        viewer.classList.add('hidden');
    }
}

// Export functions for use in other files
window.messages = {
    initSocket: initMessagesSocket,
    sendMessage: sendMessage,
    uploadFile: uploadFile,
    markRead: markMessagesAsRead,
    unsend: unsendMessage,
    edit: editMessage,
    scrollToBottom: scrollToBottom
};